---
layout: null
permalink: /assets/recipes.json
---
[
{% assign untested = site.recipes | where: "status", "ready-to-test" %}
{% assign tested = site.recipes | where: "status", "tested" %}
{% assign ready = untested | concat: tested | sort: "title" %}
{% for r in ready %}{% unless forloop.first %},{% endunless %}{
"id": {{ r.slug | jsonify }},
"name": {{ r.title | jsonify }},
"url": {{ r.url | relative_url | jsonify }},
"category": {{ r.category | jsonify }},
"cuisine": {{ r.cuisine | jsonify }},
"tags": {{ r.tags | jsonify }},
"servings": {{ r.servings | plus: 0 }},
"nutrition_verified": {{ r.nutrition_verified | default: false | jsonify }},
"ingredients": {{ r.ingredients | jsonify }}
}{% endfor %}
]